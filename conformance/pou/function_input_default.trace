# Omitted function inputs take their declared initial value.
#
# Derivation (ed.3 6.6.1.7.1, formal call: "the assignment of inputs may be
# omitted ... the input has its initial value"; 6.4.4.4 for the initial
# value itself; the same rule as pou/fb_input_defaults for function
# blocks):
#   dflt   = x * 3 + (-1)
#   with_k = x * 10 + (-1)
#   all    = x * 2 + 5
# cycle 0: x=4  -> 11, 39, 13
# cycle 1: x=0  -> -1, -1, 5
# cycle 2: x=-2 -> -7, -21, 1
period_ms: 100
program: main
inputs: x
outputs: dflt with_k all
status: conformant
reference: IEC 61131-3 ed.3 6.6.1.7.1 (formal call), 6.4.4.4 (initial values)
---
0 x=4 => dflt=11 with_k=39 all=13
1 x=0 => dflt=-1 with_k=-1 all=5
2 x=-2 => dflt=-7 with_k=-21 all=1
