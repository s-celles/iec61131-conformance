# CASE statement (ed.3 7.3.3.3.3 / ed.2 2.6.4.2): the selector is any
# expression of an integer type; a case list holds values and subranges;
# exactly one branch runs; ELSE runs when no list matches. MOD keeps the
# sign of the dividend, so x MOD 4 is in -3..3 (table 30).
# cnt is a program output, retained across cycles: it counts the cycles
# where x is in -10..0.
period_ms: 100
program: main
inputs: x
outputs: branch neg cnt
status: conformant
reference: IEC 61131-3 ed.3 7.3.3.3.3 (CASE statement), 6.6.2.5.1 table 30 (MOD)
---
0 x=5   => branch=11 neg=FALSE cnt=0
1 x=-5  => branch=11 neg=TRUE  cnt=1
2 x=6   => branch=12 neg=FALSE cnt=1
3 x=-6  => branch=12 neg=TRUE  cnt=2
4 x=7   => branch=13 neg=FALSE cnt=2
5 x=-7  => branch=13 neg=TRUE  cnt=3
6 x=0   => branch=10 neg=FALSE cnt=4
7 x=-10 => branch=12 neg=TRUE  cnt=5
8 x=-11 => branch=13 neg=FALSE cnt=5
9 x=8   => branch=10 neg=FALSE cnt=5
