# INT addition/subtraction overflow.
#
# What the standard says: IEC 61131-3 ed.3 clause 6.6.1.5 (arithmetic
# functions) defines ADD/SUB on the mathematical values and does not say
# what happens when the result does not fit in the type. Ed.2 annex E
# (table E.1, "errors") lists "numerical result exceeds range for data
# type" as an error whose detection and reaction are implementer-specific.
# So any of: wrap-around, saturation, runtime error, is permitted.
#
# What IronPLC 0.251.0 (5ea0610) does: two's-complement wrap-around, no
# error. Recorded with `conformance-ironplc --record` on 2026-10-31.
period_ms: 100
program: main
inputs: a b
outputs: s d
status: implementation-defined
reference: IEC 61131-3 ed.2 annex E table E.1; ed.3 6.6.1.5
---
0 a=1 b=2 => s=3 d=-1
# 32767 + 1 wraps to -32768
1 a=32767 b=1 => s=-32768 d=32766
# -32768 + -1 wraps to 32767; -32768 - (-1) = -32767 is in range
2 a=-32768 b=-1 => s=32767 d=-32767
# -32768 - 1 wraps to 32767
3 a=-32768 b=1 => s=-32767 d=32767
4 a=32767 b=32767 => s=-2 d=0
5 a=-32768 b=-32768 => s=0 d=0
