# CTU, PV = 3, period 100 ms (time is irrelevant).
#
# Derivation: ST body in the standard (ed.3 table 44 / ed.2 table 36):
#   VAR_INPUT CU : BOOL R_EDGE; R : BOOL; PV : INT; END_VAR
#   VAR_OUTPUT Q : BOOL; CV : INT; END_VAR
#   IF R THEN CV := 0;
#   ELSIF CU AND (CV < PVmax) THEN CV := CV + 1;
#   END_IF;
#   Q := (CV >= PV);
# (ed.3 writes the edge detection as an explicit R_TRIG on CU with the
# same effect). The edge memory is updated on every evaluation, including
# while R is TRUE, so a CU that stays TRUE across a reset does not count
# again when R drops (cycle 10). CV keeps counting past PV (cycle 8);
# Q is simply CV >= PV.
period_ms: 100
program: main
inputs: cu r
outputs: q cv
status: conformant
reference: IEC 61131-3 ed.3 6.6.3.5.3 table 44 (CTU body)
---
0  cu=FALSE r=FALSE => q=FALSE cv=0
1  cu=TRUE          => q=FALSE cv=1
# CU held: no second count
2                   => q=FALSE cv=1
3  cu=FALSE         => q=FALSE cv=1
4  cu=TRUE          => q=FALSE cv=2
5  cu=FALSE         => q=FALSE cv=2
6  cu=TRUE          => q=TRUE  cv=3
7  cu=FALSE         => q=TRUE  cv=3
# counting continues above PV
8  cu=TRUE          => q=TRUE  cv=4
# reset dominates; CU is TRUE during the reset
9  r=TRUE           => q=FALSE cv=0
# R released with CU still TRUE: no rising edge, no count
10 r=FALSE          => q=FALSE cv=0
11 cu=FALSE         => q=FALSE cv=0
12 cu=TRUE          => q=FALSE cv=1
