# Function block methods.
#
# Derivation (ed.3 6.6.3.5.1: "a method ... can access all variables of
# the function block instance"; 6.6.3.5.2 method call "instance.method"
# with formal inputs, the return value usable in an expression or
# discarded; not in ed.2, so an ed.2-only implementation fails to
# compile):
#   cv is kept by the instance; BUMP adds n and returns the new cv; CLEAR
#   clears it first when rst is TRUE. The FB body is never invoked (no
#   c() call), which does not matter to the methods.
# cycle 0: n=2 rst=F -> 2
# cycle 1: n=3 rst=F -> 5
# cycle 2: n=1 rst=T -> reset, then 1
# cycle 3: n=0 rst=F -> 1
period_ms: 100
program: main
inputs: n rst
outputs: ret cv
status: conformant
reference: IEC 61131-3 ed.3 6.6.3.5 (methods), table 48
---
0 n=2 rst=FALSE => ret=2 cv=2
1 n=3 rst=FALSE => ret=5 cv=5
2 n=1 rst=TRUE => ret=1 cv=1
3 n=0 rst=FALSE => ret=1 cv=1
