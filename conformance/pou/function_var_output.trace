# Function outputs through "=>".
#
# Derivation (ed.3 6.6.1.3: a function may have VAR_OUTPUT variables;
# 6.6.1.7.1 formal call: "output => variable" assigns the output to the
# variable after the call; ed.2 2.5.1.3 / 2.5.1.1 likewise. Integer
# division truncates toward zero and MOD takes the sign of the dividend,
# as in ops/precedence):
# cycle 0: 7 / 2    -> TRUE, 3, 1
# cycle 1: 7 / 0    -> FALSE, 0, 0 (the function's own guard)
# cycle 2: -7 / 2   -> TRUE, -3, -1
# cycle 3: 9 / 3    -> TRUE, 3, 0
period_ms: 100
program: main
inputs: a b
outputs: ok q r
status: conformant
reference: IEC 61131-3 ed.3 6.6.1.3 (function VAR_OUTPUT), 6.6.1.7.1 (formal call); ed.2 2.5.1.3
---
0 a=7 b=2 => ok=TRUE q=3 r=1
1 a=7 b=0 => ok=FALSE q=0 r=0
2 a=-7 b=2 => ok=TRUE q=-3 r=-1
3 a=9 b=3 => ok=TRUE q=3 r=0
