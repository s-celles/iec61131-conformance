# SHL truncates to the width of its input.
#
# Derivation (ed.3 table 30 / ed.2 table 25: SHL(IN, N) is IN shifted
# left by N bits with zeros filled in on the right, the result having the
# type and width of IN, so bits moved beyond the width are gone; SHR,
# ROL, ROR likewise work within the width):
#   SHL(b, 7) keeps only bit 0 of b, at bit 7; SHR by 4 puts it at bit 3:
#     b_back = 16#08 if b is odd, else 16#00.
#   SHL(b, 4) keeps the low nibble at bits 4..7; ROL 4 brings it to 0..3:
#     b_rol = b AND 16#0F.
#   SHL(w, 12) keeps bits 0..3 of w at 12..15; SHR 8 puts them at 4..7:
#     w_back = (w AND 16#000F) * 16.
#   SHL(w, 8) keeps the low byte at 8..15; ROR 8 brings it back:
#     w_ror = w AND 16#00FF.
#   b_or = 16#44 OR b_back.
# cycle 0: b=16#44 w=16#67CB -> 00, 04, 00B0, 00CB, 44
# cycle 1: b=16#77 w=16#444A -> 08, 07, 00A0, 004A, 4C
# cycle 2: b=16#E9 w=16#F0E8 -> 08, 09, 0080, 00E8, 4C
# cycle 3: b=16#FF w=16#FFFF -> 08, 0F, 00F0, 00FF, 4C
# cycle 4: b=16#00 w=16#0010 -> 00, 00, 0000, 0010, 44
# An implementation that shifts in a wider register and masks only the
# final result gives, on cycle 0, SHL(16#44, 7) = 16#2200 and then
# SHR 4 = 16#220 -> b_back = 16#20, b_or = 16#64.
period_ms: 100
program: main
inputs: b w
outputs: b_back b_rol w_back w_ror b_or
status: conformant
reference: IEC 61131-3 ed.3 table 30 (SHL SHR ROL ROR); ed.2 table 25
---
0 b=16#44 w=16#67CB => b_back=16#00 b_rol=16#04 w_back=16#00B0 w_ror=16#00CB b_or=16#44
1 b=16#77 w=16#444A => b_back=16#08 b_rol=16#07 w_back=16#00A0 w_ror=16#004A b_or=16#4C
2 b=16#E9 w=16#F0E8 => b_back=16#08 b_rol=16#09 w_back=16#0080 w_ror=16#00E8 b_or=16#4C
3 b=16#FF w=16#FFFF => b_back=16#08 b_rol=16#0F w_back=16#00F0 w_ror=16#00FF b_or=16#4C
4 b=16#00 w=16#0010 => b_back=16#00 b_rol=16#00 w_back=16#0000 w_ror=16#0010 b_or=16#44
