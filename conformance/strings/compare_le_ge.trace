# Comparison functions LE (<=) and GE (>=) on strings (ed.3 6.6.2.5.1
# table 28: they apply to ANY_ELEMENTARY, strings included; for strings the
# comparison is lexical on the character codes, and a string that is a
# prefix of a longer one is less). Here both operands are variables.
#   'abc' <= 'abd' TRUE ('c' < 'd');  'abc' <= 'abc' TRUE (equal);
#   'abc' <= 'ab'  FALSE ('ab' is a prefix of 'abc', so less);
#   'abc' >= 'abd' FALSE;  'abc' >= 'abc' TRUE;  'abc' >= 'ab' TRUE.
# No inputs; two cycles.
period_ms: 100
program: main
inputs:
outputs: le1 le2 le3 ge1 ge2 ge3
status: conformant
reference: IEC 61131-3 ed.3 6.6.2.5.1 table 28 (comparison of strings)
---
0 => le1=TRUE le2=TRUE le3=FALSE ge1=FALSE ge2=TRUE ge3=TRUE
1 => le1=TRUE le2=TRUE le3=FALSE ge1=FALSE ge2=TRUE ge3=TRUE
