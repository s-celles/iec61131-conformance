# R_TRIG and F_TRIG with CLK = TRUE from the first evaluation, period 100 ms.
#
# Derivation (ed.3 6.6.3.5.3 table 45 bodies, both with `VAR M : BOOL;`,
# so M initially FALSE):
#   R_TRIG: Q := CLK AND NOT M; M := CLK;
#   F_TRIG: Q := NOT CLK AND NOT M; M := NOT CLK;
# With CLK = TRUE on the first evaluation, R_TRIG reports a rising edge, as
# the NOTE under table 45 states ("connected to a value of BOOL#1, its Q
# output will stand at BOOL#1 after its first execution following a cold
# restart"), and F_TRIG reports nothing, since NOT CLK is FALSE.
period_ms: 100
program: main
inputs: clk
outputs: qr qf
status: conformant
reference: IEC 61131-3 ed.3 6.6.3.5.3 table 45 (R_TRIG, F_TRIG bodies and NOTE)
---
# first evaluation with CLK TRUE: a rising edge, no falling edge
0 clk=TRUE  => qr=TRUE  qf=FALSE
1           => qr=FALSE qf=FALSE
2 clk=FALSE => qr=FALSE qf=TRUE
3           => qr=FALSE qf=FALSE
4 clk=TRUE  => qr=TRUE  qf=FALSE
5 clk=FALSE => qr=FALSE qf=TRUE
